# Copy to .env (gitignored).

# Production domain on the Hostinger VPS (its A record must point at the VPS IP).
# Used by `pnpm release` (extension API URL) and `pnpm deploy:vps` (Caddy HTTPS).
VERITY_DOMAIN=
# Optional extra hostnames served the same way, space-separated (e.g. www.example.com)
VERITY_ALIASES=

# SSH target for `pnpm deploy:vps`, e.g. root@203.0.113.10
VPS_HOST=

# Extension build-time settings. Defaults work for local development.
# WXT_API_URL=http://localhost:8787
# WXT_API_TOKEN=
