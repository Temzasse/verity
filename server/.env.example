# Copy to server/.env (gitignored) and fill in.
# For production, set these same variable names in Hostinger Docker Manager.
ANTHROPIC_API_KEY=

# Optional Google Fact Check Tools API key (enable the API in your Google Cloud project).
# Adds published-review lookup behind "Check with web sources". Without it, web research still works.
GOOGLE_FACT_CHECK_API_KEY=

# Optional: an Anthropic-compatible router instead of api.anthropic.com (e.g. Hostinger AI Router),
# and the model name it expects. Leave empty to call Anthropic directly with claude-haiku-5-5.
# ANTHROPIC_BASE_URL=
# VERITY_MODEL=

# Stop calling Claude once this much (USD, estimated) has been spent today. Cached results stay free.
DAILY_BUDGET_USD=1

# Paid (uncached) requests allowed per client IP per hour.
# RATE_ANALYZE_PER_HOUR=30
# RATE_FACTCHECK_PER_HOUR=15

# Independent confidence for Smart analysis findings: TypeSafe's Jev decision model re-checks each
# finding and its probability replaces the analysis model's own confidence. Set the key to enable it;
# VERIFIER=none turns it off. Failures fall back to the analysis model's confidence.
TYPESAFE_API_KEY=
# VERIFIER=jev
# JEV_MODEL=jev-1.14.0
# Which check becomes the shown confidence: fair (default), combined or strict. All are logged as [jev] lines.
# JEV_SCORE=fair

# How the landing page's "Try it" demo fetches article links:
#   contextdev (default) = Context.dev scrape API, fewer bot blocks; needs CONTEXT_DEV_API_KEY
#   direct               = fetch from this server (free, but many news sites block it)
# With contextdev, a failed scrape (or a missing key) falls back to a direct fetch.
# SCRAPER=contextdev
CONTEXT_DEV_API_KEY=
# Heavy pages can take a while to render there; the scrape gives up after this (ms).
# CONTEXT_DEV_TIMEOUT_MS=45000
# Zero data retention at Context.dev (enable it for your Context.dev organization first).
# CONTEXT_DEV_ZDR=enabled
# Hours a scraped article is reused before fetching the page again.
# EXTRACT_CACHE_HOURS=12
# RATE_EXTRACT_PER_HOUR=30
# RATE_FEEDBACK_PER_HOUR=120

# PORT=8787
# Optional shared secret: when set, requests must send it as X-Verity-Token (build the extension with
# the same WXT_API_TOKEN). Not a real secret once the extension is public; rate limits are the real guard.
# VERITY_TOKEN=
