{
  "name": "verity",
  "description": "Verity Chrome extension",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k --handle-input -n ext,server,site -c blue,magenta,green \"pnpm:dev:ext\" \"pnpm:server\" \"pnpm:site\"",
    "dev:ext": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "test": "node --test server/*.test.ts entrypoints/content/*.test.ts",
    "postinstall": "wxt prepare",
    "server": "node --env-file-if-exists=server/.env --watch server/index.ts",
    "site": "node scripts/site-dev.mjs",
    "release": "bash scripts/release.sh",
    "deploy:vps": "bash scripts/deploy.sh",
    "reset:vps": "bash scripts/reset-cache.sh"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "concurrently": "^10.0.7",
    "typescript": "^7.0.2",
    "web-ext": "^10.8.0",
    "wxt": "0.21.5"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@huggingface/transformers": "4.3.2",
    "@mozilla/readability": "^0.6.0",
    "linkedom": "^0.18.15",
    "zod": "^4.6.7"
  }
}
